generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
}

model SeccionPagina {
  claveCampo String @id @map("clave_campo") @db.VarChar(255)
  paginaSlug String @map("pagina_slug") @db.VarChar(255)
  valor      String @db.Text
  tipo       String @db.VarChar(255)

  @@map("seccion_pagina")
}